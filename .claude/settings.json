{
  "permissions": {
    "allow": [
      "mcp__waffle__createWorkItem",
      "mcp__waffle__updateWorkItem",
      "mcp__waffle__transitionWorkItem",
      "mcp__waffle__addComment",
      "mcp__waffle__createSquare"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/guard-git.sh" }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "sm-workflow": { "source": { "source": "github", "repo": "sprint-mode/sm-workflow" } }
  },
  "enabledPlugins": { "sm-workflow@sm-workflow": true }
}
