{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sprint-mode/sm-ui/portal-standard.schema.json",
  "title": "PORTAL-LOCK portal standard",
  "description": "Shape of portal-standard.json (FEAT-3170 section G, checks 1-29). This file is the executable standard the fleet audit, portal CI and the scaffold gate all read.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "standard_version",
    "required_exports",
    "data_product_slugs",
    "required_files",
    "workflow_rules",
    "portal_configs_fields",
    "deploy_shape",
    "public_routes",
    "auth_me_shape",
    "checks"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "standard_version": {
      "type": "string",
      "minLength": 1,
      "description": "Equals the sm-ui package.json version at publish time. The bin also reads its own package.json at runtime rather than trusting this field blindly, since the publish workflow bumps package.json in the runner."
    },
    "required_exports": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "data_product_slugs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "required_files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "workflow_rules": {
      "type": "object",
      "required": ["install"],
      "properties": {
        "install": { "type": "string", "minLength": 1 }
      }
    },
    "portal_json_schema": {
      "type": "object",
      "properties": {
        "required_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "min_template_version": { "type": "string", "minLength": 1 }
      }
    },
    "brand_override_variables": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^--[a-z0-9-]+$" },
      "uniqueItems": true
    },
    "portal_configs_fields": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "deploy_shape": {
      "type": "object",
      "required": ["production_branch", "bundle_min_bytes", "bundle_content_type", "canonical_equals_main"],
      "properties": {
        "production_branch": { "type": "string", "minLength": 1 },
        "bundle_min_bytes": { "type": "integer", "minimum": 0 },
        "bundle_content_type": { "type": "string", "minLength": 1 },
        "canonical_equals_main": { "type": "boolean" }
      }
    },
    "public_routes": {
      "type": "object",
      "required": ["prerendered_or_declared"],
      "properties": {
        "prerendered_or_declared": { "type": "string", "minLength": 1 }
      }
    },
    "auth_me_shape": {
      "type": "object",
      "required": ["ok", "user"],
      "properties": {
        "ok": { "type": "boolean" },
        "user": { "type": "string", "minLength": 1 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 29,
      "maxItems": 29,
      "items": {
        "type": "object",
        "required": ["id", "key", "title", "gates", "source", "a_warns_only"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 29 },
          "key": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["A", "N", "S"] },
            "uniqueItems": true
          },
          "source": {
            "type": "string",
            "enum": ["repo", "pages", "production", "d1", "r2", "browser"]
          },
          "a_warns_only": { "type": "boolean" }
        }
      }
    }
  }
}
